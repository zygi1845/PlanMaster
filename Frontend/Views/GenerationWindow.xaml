<Window x:Class="Frontend.Views.GenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Frontend.ViewModels"
        xmlns:local="clr-namespace:Frontend.Views"
        Title="Generowanie planu" Height="450" Width="800"
        Background="#D6EAF8">
    <Window.DataContext>
        <vm:GenerationViewModel />
    </Window.DataContext>
    
    <Window.CommandBindings>
        <CommandBinding Command="vm:GenerationViewModel.GenerateCommand" 
                        Executed="GenerateCommand_Executed"/>
        <CommandBinding Command="vm:GenerationViewModel.NavigateCommand" 
                        Executed="NavigateCommand_Executed"/>
        <CommandBinding Command="{x:Static local:GenerationWindow.GenerateAndNavigateCommand}" 
                        Executed="GenerateAndNavigateCommand_Executed"/>
    </Window.CommandBindings>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="*" />            
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Generowanie"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="center" Margin="0,10"/>

        <Border Grid.Column="0" Grid.Row="1" 
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Width="500" Height="70">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="100"
                        Height="30"
                        Background="#3498DB"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TeacherCount, StringFormat='Ilość nauczycieli: {0}'}"
                               FontSize="12"
                               Foreground="Black"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Width="100"
                        Height="30"
                        Background="#3498DB"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Grid.Column="1">
                    <TextBlock Text="{Binding RoomCount, StringFormat='Ilość sal: {0}'}"
                               FontSize="12"
                               Foreground="Black"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="0" Grid.Row="2" 
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Width="500" Height="70">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="100"
                        Height="30"
                        Background="#3498DB"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClassCount, StringFormat='Ilość klas: {0}'}"
                               FontSize="12"
                               Foreground="Black"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <Border Width="100"
                        Height="30"
                        Background="#3498DB"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Grid.Column="1">
                    <TextBlock Text="{Binding ClassTypeCount, StringFormat='Ilość typów klas: {0}'}"
                               FontSize="12"
                               Foreground="Black"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Panel nawigacyjny pionowo w prawym górnym rogu, węższy i tylko na górze -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120" Height="250">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Background="#3498DB" Margin="0,0,0,10" Click="HourPlanWindow_Click"/>   
                <Button Content="Klasy" Background="#3498DB" Margin="0,0,0,10" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Background="#3498DB" Margin="0,0,0,10" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Background="#3498DB" Margin="0,0,0,10" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Background="#3498DB" Margin="0,0,0,10" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Background="#3498DB" Margin="0,0,0,10" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Background="#3498DB" Margin="0,0,0,10" Click="GenerationWindow_Click"/>         
            </StackPanel>
        </Border>
                
        <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3"  
                VerticalAlignment="Bottom" Content="Generuj plan" 
                Command="{x:Static local:GenerationWindow.GenerateAndNavigateCommand}"
                Width="120" Height="40" Margin="0,0,0,10" Background="#3498DB"/>
    </Grid>
</Window>