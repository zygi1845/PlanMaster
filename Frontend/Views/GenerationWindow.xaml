<!-- GenerationWindow.xaml -->
<Window x:Class="Frontend.Views.GenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenerationWindow" Height="450" Width="800"
        Background="#D6EAF8">
   <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />    <!-- Lewa część: tabela + przyciski -->
            <ColumnDefinition Width="Auto" />  <!-- Prawa część: nawigacja -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="*" />            
            <RowDefinition Height="*" />      <!-- Obszar główny -->
            <RowDefinition Height="Auto" />  <!-- Przyciski pod tabelą -->
        </Grid.RowDefinitions>

        <TextBlock Text="Generowanie"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="center" Margin="0,10"/>

        <Border Grid.Column="0" Grid.Row="1" 
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Width="500" Height="70">
            <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="Ilość nauczycieli: " 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="1" 
                             Text="Ilość sal: " 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>
            </Grid>
        </Border>

        <Border Grid.Column="0" Grid.Row="2" 
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Width="500" Height="70">
            <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ClassCountTextBlock"
                               Grid.Column="0"
                                Margin="0"
                                Width="200"
                                Height="30"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                FontSize="16"
                                Foreground="White"
                                Background="#3498DB"
                                Text="Ilość klas: ładowanie..."/>


                    <TextBox Grid.Column="1" 
                             Text="Ilość Typów Klas: " 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120" Height="250">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Background="#3498DB" Margin="0,0,0,10" Click="HourPlanWindow_Click"/>   
                <Button Content="Klasy" Background="#3498DB" Margin="0,0,0,10" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Background="#3498DB" Margin="0,0,0,10" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Background="#3498DB" Margin="0,0,0,10" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Background="#3498DB" Margin="0,0,0,10" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Background="#3498DB" Margin="0,0,0,10" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Background="#3498DB" Margin="0,0,0,10" Click="GenerationWindow_Click"/>         
            </StackPanel>
        </Border>
                
        <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3"  VerticalAlignment="Bottom" Content="Generuj plan" Width="120" Height="40" Margin="0,0,0,10" Background="#FFD700"/>
    </Grid>
</Window>
