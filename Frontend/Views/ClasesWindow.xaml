<Window x:Class="Frontend.Views.ClasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klasy" Height="600" Width="800"
        Background="#D6EAF8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Klasy"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10"/>

        <ScrollViewer Grid.Row="1" Grid.Column="0"
                      VerticalScrollBarVisibility="Auto" Height="400" Margin="10,0">
            <Border x:Name="DynamicznePolaBorder"
                    Visibility="Visible"
                    Background="#85C1E9"
                    CornerRadius="10"
                    Padding="10"
                    Width="500"
                    MinHeight="100">
                <ItemsControl x:Name="TypyKlasItemsControl" ItemsSource="{Binding Classes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Margin="5"
                                         Width="100"
                                         Text="{Binding NazwaTypu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3498DB"
                                         Foreground="White"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Height="30"
                                         Tag="Nazwa typu klasy"
                                         Loaded="TextBox_Loaded"
                                         GotFocus="TextBox_GotFocus"
                                         LostFocus="TextBox_LostFocus"
                                         ToolTip="Podaj nazwę typu klasy"/>

                                <TextBox Grid.Column="1"
                                         Margin="5"
                                         Width="100"
                                         Text="{Binding Ilosc_klas_typu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3498DB"
                                         Foreground="White"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Height="30"
                                         Tag="Ilość klas danego typu"
                                         Loaded="TextBox_Loaded"
                                         GotFocus="TextBox_GotFocus"
                                         LostFocus="TextBox_LostFocus"         
                                         ToolTip="Podaj ilość klas danego typu"/>

                                <Button Grid.Column="2" Content="🗑"
                                        Command="{Binding DataContext.RemoveClassCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Width="30" Height="30" Margin="5"
                                        VerticalAlignment="Center" Background="Red" Foreground="White"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>

        <Button Grid.Column="0" Grid.Row="2" HorizontalAlignment="Left" Width="150" Height="40" Margin="10,5,0,0"
                Background="#3498DB" Foreground="White" FontWeight="Bold"
                Content="Dodaj nowy typ"
                Command="{Binding AddClassCommand}" />

        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Style="{StaticResource NavigationButtonStyle}" Click="HourPlanWindow_Click"/>
                <Button Content="Klasy" Style="{StaticResource NavigationButtonStyle}" Click="ClasesWindow_Click" Background="#2980B9"/>
                <Button Content="Przedmioty" Style="{StaticResource NavigationButtonStyle}" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Style="{StaticResource NavigationButtonStyle}" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Style="{StaticResource NavigationButtonStyle}" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Style="{StaticResource NavigationButtonStyle}" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Style="{StaticResource NavigationButtonStyle}" Click="GenerationWindow_Click"/>
                <Button Content="Plany" Style="{StaticResource NavigationButtonStyle}" Click="PlansWindow_Click"/>
            </StackPanel>
        </Border>

        <Button Grid.Column="1" Grid.Row="2" Width="120" Height="40" Margin="0,5,0,0" VerticalAlignment="Top"
                Background="#28A745" Foreground="White" FontWeight="Bold"
                Content="Zapisz zmiany"
                Command="{Binding SaveCommand}" />
    </Grid>
</Window>