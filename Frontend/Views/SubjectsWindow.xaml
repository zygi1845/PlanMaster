<!-- SubjectsWindow.xaml -->
<Window x:Class="Frontend.Views.SubjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubjectsWindow" Height="450" Width="800"
        Background="#D6EAF8">
    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="*" />   
            <ColumnDefinition Width="auto" />  
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="*" />    
            <RowDefinition Height="*" /> 
            <RowDefinition Height="*" /> 
            <RowDefinition Height="Auto" /> 
        </Grid.RowDefinitions>

        <TextBlock Text="Przedmioty"
                   Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="center" Margin="0,10"/>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" 
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Width="500" Height="70">
            <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="Nazwa" 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="1" 
                             Text="Ilość godzin" 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="2" 
                             Text="Typ zajęć" 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="3" 
                             Text="Usuń przedmiot" 
                             Background="Red"
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>
            </Grid>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" 
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Width="500" Height="70">
            <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="Nazwa" 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="1" 
                             Text="Ilość godzin" 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="2" 
                             Text="Typ zajęć" 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="3" 
                             Text="Usuń przedmiot" 
                             Background="Red"
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>
            </Grid>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" 
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Width="500" Height="70">
            <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="Nazwa" 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="1" 
                             Text="Ilość godzin" 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="2" 
                             Text="Typ zajęć" 
                             Background="#3498DB" 
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>

                    <TextBox Grid.Column="3" 
                             Text="Usuń przedmiot" 
                             Background="Red"
                             Margin="0"
                             Width="100"
                             HorizontalAlignment="center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="4"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120" Height="250">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Background="#3498DB" Margin="0,0,0,10" Click="HourPlanWindow_Click"/>   
                <Button Content="Klasy" Background="#3498DB" Margin="0,0,0,10" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Background="#3498DB" Margin="0,0,0,10" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Background="#3498DB" Margin="0,0,0,10" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Background="#3498DB" Margin="0,0,0,10" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Background="#3498DB" Margin="0,0,0,10" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Background="#3498DB" Margin="0,0,0,10" Click="GenerationWindow_Click"/>         
            </StackPanel>
        </Border>
                
        <Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Bottom" Content="Dodaj z pliku" Width="120" Height="40" Margin="0,0,0,10" Background="#FFD700"/>
        
        <Button Grid.Column="2" Grid.Row="4" VerticalAlignment="Bottom" Content="Zatwierdź" Width="120" Height="40" Margin="0,0,0,5" Background="#28A745" Click="SubjectsWindow_Click"/>
    </Grid>
</Window>
