<Window x:Class="Frontend.Views.SubjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Przedmioty" Height="700" Width="900"
        Background="#D6EAF8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />    
            <RowDefinition Height="Auto" /> 
        </Grid.RowDefinitions>

        <TextBlock Text="Przedmioty"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock Text="Wybierz typ klasy: " FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ItemsControl ItemsSource="{Binding ClassTypes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding NazwaTypu}" 
                                Margin="5,0" 
                                Padding="10,5"
                                Background="#3498DB"
                                Foreground="White"
                                Command="{Binding DataContext.SelectClassTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding NazwaTypu}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="{Binding SelectedClassType, StringFormat='Przedmioty dla: {0}'}"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10"
                   Foreground="#2C3E50" FontSize="16"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" Grid.Row="3" Margin="10,0">
            <ItemsControl ItemsSource="{Binding FilteredSubjects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5" CornerRadius="5" Background="#85C1E9"> 
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        IsEditable="True"
                                        ItemsSource="{Binding DataContext.AllSubjectNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Wybierz lub wpisz nazwę przedmiotu"
                                        Background="White" 
                                        Foreground="Black"
                                        Width="150" 
                                        Height="30"
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Liczba godzin"
                                         Background="White" 
                                         Foreground="Black"
                                         Width="120" 
                                         Height="30"
                                         HorizontalAlignment="Center" 
                                         VerticalAlignment="Center"
                                         TextAlignment="Center" 
                                         VerticalContentAlignment="Center"
                                         Tag="Godziny"/>

                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding DataContext.SubjectTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding SubjectType, UpdateSourceTrigger=PropertyChanged}"
                                          Background="LightBlue" 
                                          Foreground="Black"
                                          Width="150" 
                                          Height="30"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>

                                <Button Grid.Column="3" Content="🗑" 
                                        Command="{Binding DataContext.RemoveSubjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" 
                                        Width="30" 
                                        Height="30" 
                                        Margin="5"
                                        VerticalAlignment="Center" 
                                        Background="Red" 
                                        Foreground="White"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Column="0" Grid.Row="4" HorizontalAlignment="Left" Width="150" Height="40" Margin="10,5,0,0"
                Background="#3498DB" Foreground="White" FontWeight="Bold"
                Content="Dodaj przedmiot"
                Command="{Binding AddSubjectCommand}" />

        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="4"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Style="{StaticResource NavigationButtonStyle}" Click="HourPlanWindow_Click"/>
                <Button Content="Klasy" Style="{StaticResource NavigationButtonStyle}" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Style="{StaticResource NavigationButtonStyle}" Click="SubjectsWindow_Click" Background="#2980B9"/>
                <Button Content="Sale" Style="{StaticResource NavigationButtonStyle}" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Style="{StaticResource NavigationButtonStyle}" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Style="{StaticResource NavigationButtonStyle}" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Style="{StaticResource NavigationButtonStyle}" Click="GenerationWindow_Click"/>
                <Button Content="Plany" Style="{StaticResource NavigationButtonStyle}" Click="PlansWindow_Click"/>
            </StackPanel>
        </Border>

        <Button Grid.Column="1" Grid.Row="4" Width="120" Height="40" Margin="0,5,0,0" VerticalAlignment="Top"
                Background="#28A745" Foreground="White" FontWeight="Bold"
                Content="Zapisz zmiany"
                Command="{Binding SaveCommand}" />
    </Grid>
</Window>