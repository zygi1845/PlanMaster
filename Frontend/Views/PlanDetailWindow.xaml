<Window x:Class="Frontend.Views.PlanDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlanDetailWindow" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    
    <Window.Resources>
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,15,0,15"/>
        </Style>
        
        <Style x:Key="DayHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        
        <Style x:Key="DayHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="HourCellStyle" TargetType="Border">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,10"/>
        </Style>
        
        <Style x:Key="HourTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="LessonCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="AllowDrop" Value="True"/>
        </Style>
        
        <Style x:Key="LessonBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="#7DB3E8"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <!-- Czerwona ramka jeśli konflikt -->
                <DataTrigger Binding="{Binding HasConflict}" Value="True">
                    <Setter Property="BorderBrush" Value="#FF3333"/>
                </DataTrigger>
                <!-- Normalna (bez ramki) jeśli brak konfliktu -->
                <DataTrigger Binding="{Binding HasConflict}" Value="False">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="LessonTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="SubjectTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LessonTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding PlanTitle}" Style="{StaticResource TitleStyle}"/>

        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource DayHeaderStyle}"/>
            <Border Grid.Column="1" Style="{StaticResource DayHeaderStyle}">
                <TextBlock Text="Poniedziałek" Style="{StaticResource DayHeaderTextStyle}"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource DayHeaderStyle}">
                <TextBlock Text="Wtorek" Style="{StaticResource DayHeaderTextStyle}"/>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource DayHeaderStyle}">
                <TextBlock Text="Środa" Style="{StaticResource DayHeaderTextStyle}"/>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource DayHeaderStyle}">
                <TextBlock Text="Czwartek" Style="{StaticResource DayHeaderTextStyle}"/>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource DayHeaderStyle}">
                <TextBlock Text="Piątek" Style="{StaticResource DayHeaderTextStyle}"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Hours}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Style="{StaticResource HourCellStyle}">
                                <TextBlock Text="{Binding Hour}" Style="{StaticResource HourTextStyle}"/>
                            </Border>
                            
                            <!-- Poniedziałek -->
                            <Border Grid.Column="1" Style="{StaticResource LessonCellStyle}"
                                    Drop="LessonCell_Drop" Tag="Poniedziałek"
                                    DragOver="LessonCell_DragOver">
                                <ItemsControl ItemsSource="{Binding Monday}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LessonBlockStyle}"
                                                    MouseDown="LessonBlock_MouseDown"
                                                    PreviewMouseMove="LessonBlock_PreviewMouseMove">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding przedmiot}" Style="{StaticResource SubjectTextStyle}"/>
                                                    <TextBlock Text="{Binding nauczyciel}" Style="{StaticResource LessonTextStyle}" Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding sala}" Style="{StaticResource LessonTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            
                            <!-- Wtorek -->
                            <Border Grid.Column="2" Style="{StaticResource LessonCellStyle}"
                                    Drop="LessonCell_Drop" Tag="Wtorek"
                                    DragOver="LessonCell_DragOver">
                                <ItemsControl ItemsSource="{Binding Tuesday}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LessonBlockStyle}"
                                                    MouseDown="LessonBlock_MouseDown"
                                                    PreviewMouseMove="LessonBlock_PreviewMouseMove">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding przedmiot}" Style="{StaticResource SubjectTextStyle}"/>
                                                    <TextBlock Text="{Binding nauczyciel}" Style="{StaticResource LessonTextStyle}" Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding sala}" Style="{StaticResource LessonTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            
                            <!-- Środa -->
                            <Border Grid.Column="3" Style="{StaticResource LessonCellStyle}"
                                    Drop="LessonCell_Drop" Tag="Środa"
                                    DragOver="LessonCell_DragOver">
                                <ItemsControl ItemsSource="{Binding Wednesday}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LessonBlockStyle}"
                                                    MouseDown="LessonBlock_MouseDown"
                                                    PreviewMouseMove="LessonBlock_PreviewMouseMove">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding przedmiot}" Style="{StaticResource SubjectTextStyle}"/>
                                                    <TextBlock Text="{Binding nauczyciel}" Style="{StaticResource LessonTextStyle}" Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding sala}" Style="{StaticResource LessonTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            
                            <!-- Czwartek -->
                            <Border Grid.Column="4" Style="{StaticResource LessonCellStyle}"
                                    Drop="LessonCell_Drop" Tag="Czwartek"
                                    DragOver="LessonCell_DragOver">
                                <ItemsControl ItemsSource="{Binding Thursday}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LessonBlockStyle}"
                                                    MouseDown="LessonBlock_MouseDown"
                                                    PreviewMouseMove="LessonBlock_PreviewMouseMove">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding przedmiot}" Style="{StaticResource SubjectTextStyle}"/>
                                                    <TextBlock Text="{Binding nauczyciel}" Style="{StaticResource LessonTextStyle}" Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding sala}" Style="{StaticResource LessonTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            
                            <!-- Piątek -->
                            <Border Grid.Column="5" Style="{StaticResource LessonCellStyle}"
                                    Drop="LessonCell_Drop" Tag="Piątek"
                                    DragOver="LessonCell_DragOver">
                                <ItemsControl ItemsSource="{Binding Friday}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource LessonBlockStyle}"
                                                    MouseDown="LessonBlock_MouseDown"
                                                    PreviewMouseMove="LessonBlock_PreviewMouseMove">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding przedmiot}" Style="{StaticResource SubjectTextStyle}"/>
                                                    <TextBlock Text="{Binding nauczyciel}" Style="{StaticResource LessonTextStyle}" Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding sala}" Style="{StaticResource LessonTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <!-- W sekcji z przyciskami, PRZED "Usuń Plan": -->
            <Button Content="📋 Uzupełnij brakujące" Style="{StaticResource ActionButtonStyle}"
                    Background="#9B59B6" Foreground="White"
                    Click="FillMissing_Click" Margin="5"/>
            <Button Content="Usuń Plan" Style="{StaticResource ActionButtonStyle}"
                    Background="#FF6B6B" Foreground="White"
                    Click="DeletePlan_Click"/>
            <Button Content="Cofnij" Style="{StaticResource ActionButtonStyle}"
                    Background="#FFA500" Foreground="White"
                    Click="Undo_Click"/>
            <Button Content="Zatwierdź" Style="{StaticResource ActionButtonStyle}"
                    Background="#51CF66" Foreground="White"
                    Click="Approve_Click"/>
        </StackPanel>
    </Grid>
</Window>