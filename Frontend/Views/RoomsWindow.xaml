<Window x:Class="Frontend.Views.RoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sale" Height="600" Width="800"
        Background="#D6EAF8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="*" />    
            <RowDefinition Height="Auto" /> 
        </Grid.RowDefinitions>

        <TextBlock Text="Sale"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10"/>
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="400" Grid.Column="0" Grid.Row="1" Margin="10,0">
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5" CornerRadius="5" Background="#85C1E9">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Wpisz numer sali"
                                         Background="#3498DB" Width="120" Height="30"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         TextAlignment="Center" VerticalContentAlignment="Center"
                                         Foreground="White"
                                         Tag="Numer sali"
                                         Loaded="TextBox_Loaded"
                                         GotFocus="TextBox_GotFocus"
                                         LostFocus="TextBox_LostFocus"/>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataContext.RoomsTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding RoomType, UpdateSourceTrigger=PropertyChanged}"
                                          Background="LightBlue" Width="150" Height="30"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Button Grid.Column="2" Content="🗑" 
                                        Command="{Binding DataContext.RemoveRoomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Width="30" Height="30" Margin="5"
                                        VerticalAlignment="Center" Background="Red" Foreground="White"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Column="0" Grid.Row="2" HorizontalAlignment="Left" Width="150" Height="40" Margin="10,5,0,0"
                Background="#3498DB" Foreground="White" FontWeight="Bold"
                Content="Dodaj Salę"
                Command="{Binding AddRoomCommand}" />

        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Style="{StaticResource NavigationButtonStyle}" Click="HourPlanWindow_Click"/>
                <Button Content="Klasy" Style="{StaticResource NavigationButtonStyle}" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Style="{StaticResource NavigationButtonStyle}" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Style="{StaticResource NavigationButtonStyle}" Click="RoomsWindow_Click" Background="#2980B9"/>
                <Button Content="Nauczyciele" Style="{StaticResource NavigationButtonStyle}" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Style="{StaticResource NavigationButtonStyle}" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Style="{StaticResource NavigationButtonStyle}" Click="GenerationWindow_Click"/>
                <Button Content="Plany" Style="{StaticResource NavigationButtonStyle}" Click="PlansWindow_Click"/>
            </StackPanel>
        </Border>

        <Button Grid.Column="1" Grid.Row="2" Width="120" Height="40" Margin="0,5,0,0" VerticalAlignment="Top"
                Background="#28A745" Foreground="White" FontWeight="Bold"
                Content="Zapisz zmiany"
                Command="{Binding SaveCommand}" />
    </Grid>
</Window>