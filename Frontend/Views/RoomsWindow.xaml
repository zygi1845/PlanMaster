<Window x:Class="Frontend.Views.RoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoomsWindow" Height="450" Width="800"
        Background="#D6EAF8">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="*" />   
            <ColumnDefinition Width="auto" />  
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="*" />    
            <RowDefinition Height="Auto" /> 
        </Grid.RowDefinitions>

        <TextBlock Text="Sale"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="center" Margin="0,10"/>
        
                      <ScrollViewer VerticalScrollBarVisibility="Auto" Height="300" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
    <ItemsControl ItemsSource="{Binding Rooms}">
        <ItemsControl.ItemTemplate>
    <DataTemplate>
        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5" CornerRadius="5" Background="#85C1E9">
            <Grid Margin="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

<!-- Numer -->
<TextBox Grid.Column="0"
         Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"
         ToolTip="Wpisz numer przedmiotu"
         Background="#3498DB" Width="120" Height="30"
         HorizontalAlignment="Center" VerticalAlignment="Center"
         TextAlignment="Center" VerticalContentAlignment="Center"
         Foreground="Black"
         Tag="Numer sali"
         Loaded="TextBox_Loaded"
         GotFocus="TextBox_GotFocus"
         LostFocus="TextBox_LostFocus"/>

<!-- Typ sali -->
<ComboBox Grid.Column="1"
          ItemsSource="{Binding DataContext.RoomsTypes, RelativeSource={RelativeSource AncestorType=Window}}"
          SelectedItem="{Binding RoomType, UpdateSourceTrigger=PropertyChanged}"
          Background="LightBlue" Width="150" Height="30"
          HorizontalAlignment="Center" VerticalAlignment="Center"/>


                <!-- Usuń -->
                <Button Grid.Column="3" Content="🗑" Command="{Binding DataContext.RemoveRoomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" Width="30" Height="30" Margin="5"
                        VerticalAlignment="Center" Background="Red" Foreground="White"/>

            </Grid>
        </Border>
    </DataTemplate>
</ItemsControl.ItemTemplate>

    </ItemsControl>
</ScrollViewer>


        <!-- Przycisk Dodaj przedmiot - pod listą -->
        <Button Grid.Column="0" Grid.Row="4" HorizontalAlignment="Left" Width="150" Height="40" Margin="10,5,0,0"
                Background="#3498DB" Foreground="White" FontWeight="Bold"
                Content="Dodaj Sale"
                Command="{Binding AddRoomCommand}" />

        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="4"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120" Height="250">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Background="#3498DB" Margin="0,0,0,10" Click="HourPlanWindow_Click"/>   
                <Button Content="Klasy" Background="#3498DB" Margin="0,0,0,10" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Background="#3498DB" Margin="0,0,0,10" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Background="#3498DB" Margin="0,0,0,10" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Background="#3498DB" Margin="0,0,0,10" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Background="#3498DB" Margin="0,0,0,10" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Background="#3498DB" Margin="0,0,0,10" Click="GenerationWindow_Click"/>         
            </StackPanel>
        </Border>

        <!-- Przycisk Zapisz zmiany po prawej, na dole -->
        <Button Grid.Column="2" Grid.Row="4" Width="120" Height="40" Margin="0,5,0,0" VerticalAlignment="Top"
                Background="#28A745" Foreground="White" FontWeight="Bold"
                Content="Zapisz zmiany"
                Command="{Binding SaveCommand}" />

        <!-- <Border x:Name="DeleteConfirmation" Visibility="Collapsed" Background="Red" CornerRadius="10" Padding="20"
                Grid.ColumnSpan="2" Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel x:Name="Rooms" HorizontalAlignment="Center">
                <TextBlock Text="Na pewno chcesz usunąć Salę?" Foreground="White" FontSize="16" Margin="0,0,0,10" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Nie" Width="80" Margin="5" Click="CancelDelete_Click"/>
                    <Button Content="Tak" Width="80" Margin="5" Click="RemoveRoomCommand"/>
                </StackPanel>
            </StackPanel>
        </Border> -->
    </Grid>
</Window>
