<Window x:Class="Frontend.Views.TeachersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nauczyciele" Height="700" Width="1000"
        Background="#D6EAF8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Nauczyciele"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" Grid.Row="1" Margin="0,10">
            <ItemsControl ItemsSource="{Binding Teachers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="2" Margin="5" Padding="10" 
                                CornerRadius="5" Background="#85C1E9">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Nr:" FontWeight="Bold" 
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Nr_pracownika, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#3498DB" Width="60" Height="30"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             TextAlignment="Center" Foreground="White" FontWeight="Bold"
                                             Margin="0,0,20,0"/>

                                    <TextBlock Grid.Column="1" Text="Nazwisko:" FontWeight="Bold" 
                                               VerticalAlignment="Center" Margin="80,0,5,0"/>
                                    
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Nazwisko, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#3498DB" Width="150" Height="30"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             TextAlignment="Center" Foreground="White" FontWeight="Bold"
                                             Margin="150,0,0,0"/>

                                    <Button Grid.Column="2" Content="📅 Dostępność" 
                                            Width="120" Height="30" Margin="10,0"
                                            Background="#3498DB" Foreground="White"
                                            Click="SetAvailability_Click"
                                            Tag="{Binding}"/>

                                    <Button Grid.Column="3" Content="🗑 Usuń" 
                                            Command="{Binding DataContext.RemoveTeacherCommand, 
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="80" Height="30"
                                            Background="Red" Foreground="White"/>
                                </Grid>

                                <Border BorderBrush="#2C3E50" BorderThickness="1" 
                                        Background="#ECF0F1" CornerRadius="3" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="📚 Nauczane przedmioty:" FontWeight="Bold" 
                                                   Foreground="#2C3E50" Margin="0,0,0,5"/>
                                        
                                        <ItemsControl ItemsSource="{Binding TaughtSubjects}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White" BorderBrush="#95A5A6" 
                                                            BorderThickness="1" CornerRadius="3" 
                                                            Padding="5" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <TextBlock Grid.Column="0" 
                                                                       Text="{Binding Name}" 
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"/>
                                                            
                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding Hours, StringFormat='({0}h/tyg)'}" 
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0"
                                                                       Foreground="#7F8C8D"/>
                                                            
                                                            <Button Grid.Column="2" Content="✖" 
                                                                    Width="20" Height="20"
                                                                    Background="#E74C3C" Foreground="White"
                                                                    FontSize="10" FontWeight="Bold"
                                                                    Command="{Binding DataContext.RemoveSubjectFromTeacherCommand, 
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="➕ Dodaj przedmiot" 
                                                Width="150" Height="25" Margin="0,10,0,0"
                                                Background="#27AE60" Foreground="White"
                                                Command="{Binding DataContext.AddSubjectToTeacherCommand, 
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Column="0" Grid.Row="2" HorizontalAlignment="Left" 
                Width="150" Height="40" Margin="10,10,0,0"
                Background="#3498DB" Foreground="White" FontWeight="Bold"
                Content="➕ Dodaj nauczyciela"
                Command="{Binding AddTeacherCommand}" />

        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" 
                           Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Style="{StaticResource NavigationButtonStyle}" Click="HourPlanWindow_Click"/>
                <Button Content="Klasy" Style="{StaticResource NavigationButtonStyle}" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Style="{StaticResource NavigationButtonStyle}" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Style="{StaticResource NavigationButtonStyle}" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Style="{StaticResource NavigationButtonStyle}" Click="TeachersWindow_Click" Background="#2980B9"/>
                <Button Content="Wagi" Style="{StaticResource NavigationButtonStyle}" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Style="{StaticResource NavigationButtonStyle}" Click="GenerationWindow_Click"/>
                <Button Content="Plany" Style="{StaticResource NavigationButtonStyle}" Click="PlansWindow_Click"/>
            </StackPanel>
        </Border>

        <Button Grid.Column="1" Grid.Row="2" Width="120" Height="40" 
                Margin="0,10,0,0" VerticalAlignment="Top"
                Background="#28A745" Foreground="White" FontWeight="Bold"
                Content="💾 Zapisz zmiany"
                Command="{Binding SaveCommand}" />
    </Grid>
</Window>