<Window x:Class="Frontend.Views.WeightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wagi przedmiotów" Height="450" Width="800"
        Background="#D6EAF8">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="*" />   
            <ColumnDefinition Width="auto" />  
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />    
            <RowDefinition Height="Auto" /> 
        </Grid.RowDefinitions>

        <TextBlock Text="Wagi przedmiotów"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10"/>
        
        <!-- Maksymalna liczba godzin z wagą -->
        <Border Grid.Row="1" Grid.Column="0" Background="#85C1E9" CornerRadius="5" Margin="0,5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Maks. godzin w dniu:" 
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,10,0"/>
                
                <TextBox Grid.Column="1" Text="{Binding MaxHoursPerDay, Mode=TwoWay}" 
                         Width="50" Height="30"
                         Background="#3498DB" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center"
                         ToolTip="Maksymalna łączna liczba godzin lekcyjnych w jednym dniu"/>
                
                <TextBlock Text="Waga:" 
                           Grid.Column="2"
                           VerticalAlignment="Center" Margin="10,0,5,0"
                           FontWeight="SemiBold"/>
                
                <TextBox Grid.Column="3" Text="{Binding MaxHoursWeight, Mode=TwoWay}" 
                         Width="50" Height="30"
                         Background="#3498DB" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center"
                         ToolTip="Jak ważne jest przestrzeganie limitu (1-10)"/>
            </Grid>
        </Border>

        <!-- Waga przerw -->
        <Border Grid.Row="2" Grid.Column="0" Background="#85C1E9" CornerRadius="5" Margin="0,5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Waga priorytetu przerw:" 
                           Grid.Column="0"
                           HorizontalAlignment="center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,10,0"/>
                
                <TextBox Grid.Column="1" Text="{Binding BreaksWeight, Mode=TwoWay}" 
                         Width="50" Height="30"
                         Background="#3498DB" Foreground="White"
                         HorizontalAlignment="center" VerticalAlignment="Center"
                         TextAlignment="Center"
                         ToolTip="Jak ważne są przerwy między lekcjami (1-10)"/>
            </Grid>
        </Border>

        <!-- Lista przedmiotów -->
        <ScrollViewer Grid.Row="3" Grid.Column="0" VerticalScrollBarVisibility="Auto" Height="150">
            <ItemsControl ItemsSource="{Binding SubjectWeights}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5" CornerRadius="5" Background="#85C1E9">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Nazwa przedmiotu -->
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding Name, StringFormat='Przedmiot: {0}'}" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontWeight="Bold"/>

                                <!-- Godziny tygodniowo (tylko do odczytu) -->
                                <TextBlock Grid.Column="1" Text="{Binding Hours}" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           ToolTip="Liczba godzin tygodniowo"/>

                                <!-- Maksymalnie dziennie -->
                                <TextBox Grid.Column="2" Text="{Binding MaxPerDay, Mode=TwoWay}"
                                         Background="#3498DB" Width="50" Height="30"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         TextAlignment="Center" Foreground="White"
                                         ToolTip="Maksymalna liczba godzin dziennie"/>

                                <!-- Waga -->
                                <TextBox Grid.Column="3" Text="{Binding Weight, Mode=TwoWay}"
                                         Background="#3498DB" Width="50" Height="30"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         TextAlignment="Center" Foreground="White"
                                         ToolTip="Waga priorytetu (1-10)"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Panel nawigacji -->
        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="4"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120" Height="250">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Background="#3498DB" Margin="0,0,0,10" Click="HourPlanWindow_Click"/>   
                <Button Content="Klasy" Background="#3498DB" Margin="0,0,0,10" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Background="#3498DB" Margin="0,0,0,10" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Background="#3498DB" Margin="0,0,0,10" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Background="#3498DB" Margin="0,0,0,10" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Background="#3498DB" Margin="0,0,0,10" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Background="#3498DB" Margin="0,0,0,10" Click="GenerationWindow_Click"/>         
            </StackPanel>
        </Border>

        <Button Grid.Column="2" Grid.Row="4" Width="120" Height="40" Margin="0,5,0,0" VerticalAlignment="Top"
                Background="#28A745" Foreground="White" FontWeight="Bold"
                Content="Zapisz zmiany"
                Command="{Binding SaveCommand}" />
    </Grid>
</Window>