<Window x:Class="Frontend.Views.WeightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wagi przedmiotów" Height="600" Width="900"
        Background="#D6EAF8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />    
            <RowDefinition Height="Auto" /> 
        </Grid.RowDefinitions>

        <TextBlock Text="Wagi przedmiotów"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10"/>
        
        <Border Grid.Row="1" Grid.Column="0" Background="#85C1E9" CornerRadius="5" Margin="0,5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Maks. godzin w dniu:" 
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,10,0"/>
                
                <TextBox Grid.Column="1" Text="{Binding MaxHoursPerDay, Mode=TwoWay}" 
                         Width="50" Height="30"
                         Background="#3498DB" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center"
                         ToolTip="Maksymalna łączna liczba godzin lekcyjnych w jednym dniu"/>
                
                <TextBlock Text="Waga:" 
                           Grid.Column="2"
                           VerticalAlignment="Center" Margin="10,0,5,0"
                           FontWeight="SemiBold"/>
                
                <TextBox Grid.Column="3" Text="{Binding MaxHoursWeight, Mode=TwoWay}" 
                         Width="50" Height="30"
                         Background="#3498DB" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center"
                         ToolTip="Jak ważne jest przestrzeganie limitu (1-10)"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Background="#85C1E9" CornerRadius="5" Margin="0,5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Waga priorytetu przerw:" 
                           Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,10,0"/>
                
                <TextBox Grid.Column="1" Text="{Binding BreaksWeight, Mode=TwoWay}" 
                         Width="50" Height="30"
                         Background="#3498DB" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center"
                         ToolTip="Jak ważne są przerwy między lekcjami (1-10)"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SubjectWeights}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" Margin="5" Padding="5" CornerRadius="5" Background="#85C1E9">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="{Binding Name, StringFormat='Przedmiot: {0}'}" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontWeight="Bold"/>

                                <TextBlock Grid.Column="1" Text="{Binding Hours}" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           ToolTip="Liczba godzin tygodniowo"/>

                                <TextBox Grid.Column="2" Text="{Binding MaxPerDay, Mode=TwoWay}"
                                         Background="#3498DB" Width="50" Height="30"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         TextAlignment="Center" Foreground="White"
                                         ToolTip="Maksymalna liczba godzin dziennie"/>

                                <TextBox Grid.Column="3" Text="{Binding Weight, Mode=TwoWay}"
                                         Background="#3498DB" Width="50" Height="30"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         TextAlignment="Center" Foreground="White"
                                         ToolTip="Waga priorytetu (1-10)"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="4"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Style="{StaticResource NavigationButtonStyle}" Click="HourPlanWindow_Click"/>
                <Button Content="Klasy" Style="{StaticResource NavigationButtonStyle}" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Style="{StaticResource NavigationButtonStyle}" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Style="{StaticResource NavigationButtonStyle}" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Style="{StaticResource NavigationButtonStyle}" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Style="{StaticResource NavigationButtonStyle}" Click="WeightsWindow_Click" Background="#2980B9"/>
                <Button Content="Generowanie" Style="{StaticResource NavigationButtonStyle}" Click="GenerationWindow_Click"/>
                <Button Content="Plany" Style="{StaticResource NavigationButtonStyle}" Click="PlansWindow_Click"/>
            </StackPanel>
        </Border>

        <Button Grid.Column="1" Grid.Row="4" Width="120" Height="40" Margin="0,5,0,0" VerticalAlignment="Top"
                Background="#28A745" Foreground="White" FontWeight="Bold"
                Content="Zapisz zmiany"
                Command="{Binding SaveCommand}" />
    </Grid>
</Window>