<Window x:Class="Frontend.Views.PlansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plany Zajęć" Height="700" Width="1000"
        Background="#D6EAF8"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Text="Plany Zajęć" 
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10"/>

        <!-- Wybór typu planu -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock Text="Wybierz typ: " FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton Content="Klasy" Margin="10,0" IsChecked="{Binding IsClassView}" GroupName="PlanType"/>
            <RadioButton Content="Nauczyciele" Margin="10,0" IsChecked="{Binding IsTeacherView}" GroupName="PlanType"/>
            <RadioButton Content="Sale" Margin="10,0" IsChecked="{Binding IsRoomView}" GroupName="PlanType"/>
        </StackPanel>

        <!-- Kafelek z planami -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CurrentItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButtonStyle}"
                                Content="{Binding Name}"
                                Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Width="150" Height="100"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Panel nawigacji -->
        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Style="{StaticResource NavigationButtonStyle}" Click="HourPlanWindow_Click"/>   
                <Button Content="Klasy" Style="{StaticResource NavigationButtonStyle}" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Style="{StaticResource NavigationButtonStyle}" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Style="{StaticResource NavigationButtonStyle}" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Style="{StaticResource NavigationButtonStyle}" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Style="{StaticResource NavigationButtonStyle}" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Style="{StaticResource NavigationButtonStyle}" Click="GenerationWindow_Click"/>
                <Button Content="Plany" Style="{StaticResource NavigationButtonStyle}" Click="PlansWindow_Click" Background="#2980B9"/>         
            </StackPanel>
        </Border>
    </Grid>
</Window>