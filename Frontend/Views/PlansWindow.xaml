<Window x:Class="Frontend.Views.PlansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Frontend.ViewModels"
        Title="Plany Zajęć" Height="700" Width="1000"
        Background="#D6EAF8"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- CONVERTER -->
        <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Text="Plany Zajęć" 
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10"/>

        <!-- Wybór typu planu -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <TextBlock Text="Wybierz typ: " FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <RadioButton Content="Klasy" 
                         IsChecked="{Binding SelectedViewType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Classes}"
                         GroupName="ViewType" Margin="10,0" VerticalAlignment="Center"/>
            <RadioButton Content="Nauczyciele" 
                         IsChecked="{Binding SelectedViewType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Teachers}"
                         GroupName="ViewType" Margin="10,0" VerticalAlignment="Center"/>
            <RadioButton Content="Sale" 
                         IsChecked="{Binding SelectedViewType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Rooms}"
                         GroupName="ViewType" Margin="10,0" VerticalAlignment="Center"/>
            <RadioButton Content="Błędy" 
                         IsChecked="{Binding SelectedViewType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Errors}"
                         GroupName="ViewType" Margin="10,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- LISTA DLA BŁĘDÓW, KAFELKI DLA RESZTY -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="10,0">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Content">
                                        <!-- DEFAULT: Kafelek -->
                                        <Setter.Value>
                                            <Button Style="{StaticResource TileButtonStyle}"
                                                    Content="{Binding Name}"
                                                    Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="150" Height="100"/>
                                        </Setter.Value>
                                    </Setter>
                                    
                                    <Style.Triggers>
                                        <!-- Błędy -->
                                        <DataTrigger Binding="{Binding Type}" Value="Error">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Border Margin="5,2" Padding="10,5" Background="#FFEBEE" CornerRadius="5" BorderBrush="#E74C3C" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#C0392B"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <!-- W sekcji Style.Triggers, po DataTrigger dla "Error" -->
                                        <DataTrigger Binding="{Binding Type}" Value="Gap">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Border Margin="5,2" Padding="10,5" Background="#FFF9E6" CornerRadius="5" BorderBrush="#F39C12" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#D68910"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        
                                        <!-- Nagłówki -->
                                        <DataTrigger Binding="{Binding Type}" Value="Header">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Border Margin="5,10,5,5" Padding="10">
                                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                                    </Border>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        
                                        <!-- Podsumowanie -->
                                        <DataTrigger Binding="{Binding Type}" Value="Summary">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Border Margin="5,2" Padding="10,5" Background="#E8F8F5" CornerRadius="5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#16A085"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        
                                        <!-- Separator -->
                                        <DataTrigger Binding="{Binding Type}" Value="Separator">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Border Margin="5,5" Padding="5">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#BDC3C7" TextAlignment="Center"/>
                                                    </Border>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        
                                        <!-- Sukces -->
                                        <DataTrigger Binding="{Binding Type}" Value="Success">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Border Margin="10" Padding="20" Background="#D5F4E6" CornerRadius="10" BorderBrush="#27AE60" BorderThickness="2">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Icon}" FontSize="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="#27AE60"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
                <!-- Panel - dynamiczny (lista lub kafelki) -->
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Dla błędów - pionowa lista -->
                            <DataTrigger Binding="{Binding SelectedViewType}" Value="Errors">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>

        <!-- Panel nawigacji -->
        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Style="{StaticResource NavigationButtonStyle}" Click="HourPlanWindow_Click"/>   
                <Button Content="Klasy" Style="{StaticResource NavigationButtonStyle}" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Style="{StaticResource NavigationButtonStyle}" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Style="{StaticResource NavigationButtonStyle}" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Style="{StaticResource NavigationButtonStyle}" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Style="{StaticResource NavigationButtonStyle}" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Style="{StaticResource NavigationButtonStyle}" Click="GenerationWindow_Click"/>
                <Button Content="Plany" Style="{StaticResource NavigationButtonStyle}" Click="PlansWindow_Click" Background="#2980B9"/>         
            </StackPanel>
        </Border>
    </Grid>
</Window>