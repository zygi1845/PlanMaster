<Window x:Class="Frontend.Views.HourPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plan Godzinowy" Height="600" Width="800"
        Background="#D6EAF8"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Plan godzinowy"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10,0,20"/>

        <DataGrid x:Name="MyDataGrid"
                  Grid.Column="0" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="470"
                  Height="Auto"
                  MaxHeight="400"
                  RowHeight="35"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Godzina" Binding="{Binding Hour, Mode=TwoWay}" Width="90"/>
                <DataGridTextColumn Header="Poniedziałek" Binding="{Binding Monday}" Width="75"/>
                <DataGridTextColumn Header="Wtorek" Binding="{Binding Tuesday}" Width="75"/>
                <DataGridTextColumn Header="Środa" Binding="{Binding Wednesday}" Width="75"/>
                <DataGridTextColumn Header="Czwartek" Binding="{Binding Thursday}" Width="75"/>
                <DataGridTextColumn Header="Piątek" Binding="{Binding Friday}" Width="75"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="0" Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,10">
            <Button Content="Dodaj wiersz" 
                    Width="150" 
                    Height="45" 
                    Margin="0,0,20,0" 
                    Background="#3498DB" 
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Click="AddRow_Click"/>
            <Button Content="Usuń zaznaczony" 
                    Width="150" 
                    Height="45" 
                    Background="#E74C3C" 
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Click="DeleteRow_Click"/>
        </StackPanel>

        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Style="{StaticResource NavigationButtonStyle}" Click="HourPlanWindow_Click" Background="#2980B9"/>   
                <Button Content="Klasy" Style="{StaticResource NavigationButtonStyle}" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Style="{StaticResource NavigationButtonStyle}" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Style="{StaticResource NavigationButtonStyle}" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Style="{StaticResource NavigationButtonStyle}" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Style="{StaticResource NavigationButtonStyle}" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Style="{StaticResource NavigationButtonStyle}" Click="GenerationWindow_Click"/>
                <Button Content="Plany" Style="{StaticResource NavigationButtonStyle}" Click="PlansWindow_Click"/>
            </StackPanel>
        </Border>
        
        <Button Grid.Column="1" Grid.Row="2" 
                VerticalAlignment="Bottom"
                Content="Zatwierdź" 
                Width="120" 
                Height="45"
                Margin="10,0,0,10" 
                Background="#28A745"
                Foreground="White"
                FontSize="14"
                FontWeight="Bold"
                Click="ConfirmButton_Click"/>

    </Grid>
</Window>