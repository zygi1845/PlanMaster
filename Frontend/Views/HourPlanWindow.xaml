<Window x:Class="Frontend.Views.HourPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hour Plan" Height="450" Width="800"
        Background="#D6EAF8">
    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />    <!-- Lewa część: tabela + przyciski -->
            <ColumnDefinition Width="Auto" />  <!-- Prawa część: nawigacja -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="*" />     <!-- Obszar główny -->
            <RowDefinition Height="Auto" />  <!-- Przyciski pod tabelą -->
        </Grid.RowDefinitions>

        <TextBlock Text="Plan godzinowy"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="center" Margin="0,10"/>

        <!-- DataGrid z ustawioną stałą wysokością wiersza -->
        <DataGrid x:Name="MyDataGrid"
                  Grid.Column="0" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Width="500"
                  Height="260"
                  RowHeight="30"         
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Godzina" Binding="{Binding Hour, Mode=TwoWay}" Width="80"/>
                <DataGridTextColumn Header="Poniedziałek" Binding="{Binding Col2}" Width="60"/>
                <DataGridTextColumn Header="Wtorek" Binding="{Binding Col3}" Width="60"/>
                <DataGridTextColumn Header="Środa" Binding="{Binding Col4}" Width="60"/>
                <DataGridTextColumn Header="Czwartek" Binding="{Binding Col5}" Width="60"/>
                <DataGridTextColumn Header="Piątek" Binding="{Binding Col6}" Width="60"/>
                <DataGridTextColumn Header="Sobota" Binding="{Binding Col7}" Width="60"/>
                <DataGridTextColumn Header="Niedziela" Binding="{Binding Col8}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Przyciski Dodaj / Usuń pod tabelą, wyśrodkowane -->
        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0" >
            <Button Content="Dodaj wiersz" Width="120" Height="20" Margin="0,0,20,0" Click="AddRow_Click"/>
            <Button Content="Usuń zaznaczony" Width="140" Height="20" Click="DeleteRow_Click"/>
        </StackPanel>

        <!-- Panel nawigacyjny pionowo w prawym górnym rogu, węższy i tylko na górze -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                Background="#85C1E9" CornerRadius="10" Padding="10" Margin="10,0,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="120" Height="250">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nawigacja" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="White"/>
                <Button Content="Plan godzinowy" Background="#3498DB" Margin="0,0,0,10" Click="HourPlanWindow_Click"/>   
                <Button Content="Klasy" Background="#3498DB" Margin="0,0,0,10" Click="ClasesWindow_Click"/>
                <Button Content="Przedmioty" Background="#3498DB" Margin="0,0,0,10" Click="SubjectsWindow_Click"/>
                <Button Content="Sale" Background="#3498DB" Margin="0,0,0,10" Click="RoomsWindow_Click"/>
                <Button Content="Nauczyciele" Background="#3498DB" Margin="0,0,0,10" Click="TeachersWindow_Click"/>
                <Button Content="Wagi" Background="#3498DB" Margin="0,0,0,10" Click="WeightsWindow_Click"/>
                <Button Content="Generowanie" Background="#3498DB" Margin="0,0,0,10" Click="GenerationWindow_Click"/>         
            </StackPanel>
        </Border>
                
        <Button Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Bottom" Content="Dodaj z pliku" Width="120" Height="40" Margin="0,0,0,10" Background="#FFD700"/>
        
        <Button Grid.Column="1" Grid.Row="2" VerticalAlignment="Bottom"
                Content="Zatwierdź Godziny" Width="120" Height="40"
                Margin="0,0,0,5" Background="#28A745" Click="ConfirmButton_Click"/>


    </Grid>
</Window>
