<Window x:Class="Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlanMaster" Height="450" Width="700"
        Background="#D6EAF8"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PlanMaster"
                   FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,10"/>
        
        <TextBlock Grid.Row="1"
                   Text="Twórz i edytuj plan zajęć szybko i wygodnie!"
                   FontSize="18"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        
        <Button Grid.Row="2"
                Content="Rozpocznij planowanie"
                Background="#3498DB"
                Foreground="White"
                FontWeight="Bold"
                Padding="15,10"
                FontSize="16"
                Width="200"
                Height="45"
                HorizontalAlignment="Center"
                Margin="0,20"
                Click="HourPlanWindow_Click"/>
    </Grid>
</Window>